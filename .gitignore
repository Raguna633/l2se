*.swo
*~

# Temporary & Log Files
*.log
tmp/
temp/

# Standalone / Nested Projects inside Topic Folders
# Secara default, proyek nyata di dalam folder projects/ dikelola sebagai repo Git mandiri (multi-repo)
# atau tetap lokal agar repositori framework utama tetap ringan (pertahankan .gitkeep).
# Untuk melacak mini-lab tertentu ke dalam repo utama, gunakan: git add -f <path>
**/projects/*
!**/projects/.gitkeep

# Profil Pelajar & Cadangan Lokal
# Secara default, LEARNER.md dan cadangan lokalnya diabaikan Git agar privasi profil
# tetap terjaga di repositori publik. Untuk melacak LEARNER.md, gunakan: git add -f LEARNER.md
LEARNER.md
.l2se-backup/
